---
import { profile } from '../data/site';
---
<section class="wrap hero" id="top" aria-labelledby="hero-title">
  <div class="hero-copy-block">
    <p class="kicker" data-lang="zh">{profile.hero.kicker.zh}</p>
    <p class="kicker" data-lang="en">{profile.hero.kicker.en}</p>
    <h1 id="hero-title"><span data-lang="zh">{profile.hero.title.zh}<em>{profile.hero.emphasis.zh}</em></span><span data-lang="en">{profile.hero.title.en} <em>{profile.hero.emphasis.en}</em></span></h1>
    <p class="folio">MR Z / PORTFOLIO · 2026</p>
  </div>
  <div class="hero-stage" aria-label="CleanMaster product preview">
    <div class="ambient-orb orb-blue"></div><div class="ambient-orb orb-violet"></div>
    <div class="product-window glass-elevated">
      <div class="window-bar"><div class="traffic"><i></i><i></i><i></i></div><strong>CleanMaster</strong><span class="window-status"><i></i><span data-lang="zh">系统就绪</span><span data-lang="en">System ready</span></span></div>
      <div class="window-content">
        <aside class="window-sidebar"><div class="window-logo">C</div><div class="window-nav active"><span>▤</span><span data-lang="zh">磁盘清理</span><span data-lang="en">Disk cleanup</span></div><div class="window-nav"><span>◌</span><span data-lang="zh">大文件</span><span data-lang="en">Large files</span></div><div class="window-nav"><span>⌁</span><span data-lang="zh">软件管理</span><span data-lang="en">Applications</span></div><div class="window-nav"><span>⚙</span><span data-lang="zh">设置</span><span data-lang="en">Settings</span></div></aside>
        <div class="window-main"><div class="window-heading"><div><span class="window-eyebrow">DISK / C:</span><h2 data-lang="zh">磁盘清理</h2><h2 data-lang="en">Disk cleanup</h2></div><span class="scan-state" data-lang="zh">已完成扫描</span><span class="scan-state" data-lang="en">Scan complete</span></div><div class="space-card"><div class="space-ring"><span>4.8</span><small>GB</small></div><div><b data-lang="zh">建议清理</b><b data-lang="en">Recommended cleanup</b><p data-lang="zh">扫描结果已按风险和类别整理。</p><p data-lang="en">Results grouped by category and risk.</p></div></div><div class="window-list"><div><span class="list-check"></span><span data-lang="zh">系统缓存</span><span data-lang="en">System cache</span><b>2.4 GB</b></div><div><span class="list-check"></span><span data-lang="zh">临时文件</span><span data-lang="en">Temporary files</span><b>1.7 GB</b></div><div><span class="list-check caution"></span><span data-lang="zh">重复文件</span><span data-lang="en">Duplicate files</span><b>0.7 GB</b></div></div><button class="window-cta" type="button"><span data-lang="zh">查看清理项</span><span data-lang="en">Review items</span><span>→</span></button></div>
      </div>
    </div>
    <div class="floating-note"><span class="note-dot"></span><div><b data-lang="zh">为清晰而设计</b><b data-lang="en">Designed for clarity</b><small data-lang="zh">先理解，再操作。</small><small data-lang="en">Understand before acting.</small></div></div>
    <p class="stage-caption"><span data-lang="zh">CleanMaster / 产品界面</span><span data-lang="en">CleanMaster / Product interface</span></p>
  </div>
  <div class="hero-bottom"><p data-lang="zh">{profile.hero.copy.zh}</p><p data-lang="en">{profile.hero.copy.en}</p><a class="text-link" href="#work"><span data-lang="zh">查看作品</span><span data-lang="en">View selected work</span></a></div>
</section>
